{
  "manifest_version": 3,
  "name": "NoPhish",
  "version": "1.0",
  "description": "AI powered browser extension for detecting malicious scripts and phishing attempts.",
  
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  
  "icons": {
    "128": "icon.png"
  },
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["dom_analyzer.js", "pipeline.js", "content.js"],
    "css": ["indicator.css"],
    "run_at": "document_idle"
  }
],
  "background": {
    "service_worker": "background.js"
  }
}

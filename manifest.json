{
  "manifest_version": 3,
  "name": "NoPhish",
  "version": "1.0",
  "description": "AI powered browser extension for detecting malicious scripts and phishing attempts.",
  
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo(1).png"
  },
  
  "icons": {
    "128": "logo.png"
  },
  
  "permissions": [
    "storage"
  ],
  "background": {
  "service_worker": "background.js"
},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
